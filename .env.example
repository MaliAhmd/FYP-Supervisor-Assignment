# All live integrations are disabled by default. Never commit your real .env.
LLM_MODE=fake
GITHUB_MODE=fake
EMAIL_MODE=test
EMAIL_SENDER=smtp
TEST_REDIRECT_EMAIL=supervisor-test@example.com
DATABASE_PATH=data/supervisorai.sqlite3
# Relative to your home directory, outside the source tree.
TOKEN_DIR=~/.supervisorai/tokens

GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_VERSION=2026-03-10
GITHUB_MAX_PAGES=10
GITHUB_MAX_RESPONSE_BYTES=10485760
GITHUB_MAX_FILES=3000
GITHUB_BACKOFF_MAX_SECONDS=3600
GOOGLE_CLIENT_SECRETS_FILE=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Progress
SHEETS_MAX_ROWS=5000
SHEETS_MAX_COLUMNS=256

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=aliahmadm754@gmail.com
SMTP_PASSWORD=
SMTP_FROM=supervisor@example.com
SMTP_TLS_MODE=starttls

POLL_SECONDS=60
REPLY_POLL_SECONDS=300
GMAIL_PAGES_PER_TICK=3
EMAIL_MAX_BYTES=1048576
EMAIL_MAX_BODY_CHARS=100000
DEBOUNCE_SECONDS=300
MAX_LLM_CALLS_PER_CYCLE=6
MAX_LLM_CALLS_PER_BATCH=25
MAX_COORDINATOR_CALLS=2
MAX_SPECIALIST_TOOL_CALLS=6
MAX_INPUT_TOKENS=3000
MAX_OUTPUT_TOKENS=700
JSON_REPAIR_RETRIES=1
DAILY_TOKEN_QUOTA=30000
MAX_HTTP_RETRIES=3
REQUEST_TIMEOUT_SECONDS=30
REPORT_TOP_K=4
MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=200
PDF_MAX_TEXT_CHARS=200000
PDF_MAX_STREAM_BYTES=8388608
PDF_TIMEOUT_SECONDS=30
PDF_PASSAGE_CHARS=600
MAX_DIFF_CHARS_PER_FILE=8000
# Conservative local pacing; response headers further constrain these values.
LLM_REQUESTS_PER_MINUTE=10
LLM_TOKENS_PER_MINUTE=6000
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=60
GROQ_REASONING_EFFORT=low
